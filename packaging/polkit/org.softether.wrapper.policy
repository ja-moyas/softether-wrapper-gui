<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SoftEther VPN Wrapper</vendor>
  <vendor_url>https://github.com/SoftEther-VPN-Wrapper</vendor_url>

  <action id="org.softether.wrapper.manage">
    <description gettext-domain="softether-wrapper">Manage the SoftEther VPN client</description>
    <message gettext-domain="softether-wrapper">Authentication is required to manage the SoftEther VPN client</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
