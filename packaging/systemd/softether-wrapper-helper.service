[Unit]
Description=SoftEther VPN Wrapper D-Bus Helper
Documentation=https://github.com/SoftEther-VPN-Wrapper
After=dbus.service network.target
Wants=dbus.service
# The helper can start/stop the client on demand, so it must not hard-depend on
# the client unit; it only needs to be able to report its state.

[Service]
Type=simple
ExecStart=/opt/softether-wrapper/venv/bin/python -m softether_wrapper_helper.service
Environment=PYTHONPATH=/opt/softether-wrapper/lib
Environment=SOFTETHER_WRAPPER_VPNCMD=/usr/bin/vpncmd
RuntimeDirectory=softether-wrapper
RuntimeDirectoryMode=0700
StateDirectory=softether-wrapper
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2

# Hardening (mirrors softether-vpnclient.service, with home access kept for
# import/export of connection settings and certificates).
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home /run/softether
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
